struct rgb {
    float r;
    float g;
    float b;

    rgb& operator=(const rgba& color); 

    bool isDefault() const {
        return r == 0 && g == 0 && b == 0;
    }
};


inline rgba& rgba::operator=(const rgb& color) {
    r = color.r;
    g = color.g;
    b = color.b;
    a = 1.0f;
    return *this;
}

inline rgb& rgb::operator=(const rgba& color) {
    r = color.r;
    g = color.g;
    b = color.b;
    return *this;
}

